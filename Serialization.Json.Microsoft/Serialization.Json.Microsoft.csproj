<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Depra.Serialization.Json.Microsoft</AssemblyName>
        <RootNamespace>Depra.Serialization.Json.Microsoft</RootNamespace>
        <Version>1.1.0</Version>
        <Authors>Nikolay Melnikov</Authors>
        <Company>Depra</Company>
        <Description>Adapter for serializer from System.Text.Json.</Description>
        <Copyright>Copyright © 2022-2023 Nikolay Melnikov. All rights reserved.</Copyright>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <RepositoryUrl>https://github.com/Depression-aggression/Serialization</RepositoryUrl>
        <RepositoryType>Module</RepositoryType>
        <PackageTags>Depra, Serialization, Adapter, Integration, System, Text, Json</PackageTags>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <TargetFrameworks>netstandard2.1;net7.0</TargetFrameworks>
        <PackageReleaseNotes>Namespaces cleaned; 
Interfaces separated,
License updated</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <Optimize>true</Optimize>
      <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Serialization\Serialization.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="System.Text.Json" Version="10.0.12" />
    </ItemGroup>
</Project>
